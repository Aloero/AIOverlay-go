{
  "version": 1,
  "app": {
    "name": "AIOverlay",
    "secret_storage": "portable_json",
    "persist_runtime_stats": true,
    "catalog_refresh_hours": 24
  },
  "providers": [
    {
      "id": "opencode",
      "label": "Embedded OpenCode",
      "kind": "embedded_opencode",
      "enabled": true,
      "opencode_provider_id": "opencode",
      "credential_pool": {
        "policy": "round_robin",
        "keys": null,
        "max_keys_per_request": 1,
        "rate_limit_cooldown_s": 60
      },
      "request_defaults": {
        "connect_timeout_ms": 3000,
        "first_token_timeout_ms": 8000,
        "response_timeout_ms": 15000,
        "stream_idle_timeout_ms": 5000,
        "max_output_tokens": 2048
      }
    },
    {
      "id": "openrouter",
      "label": "OpenRouter",
      "kind": "openai_compatible",
      "enabled": true,
      "base_url": "https://openrouter.ai/api/v1",
      "models_url": "https://openrouter.ai/api/v1/models",
      "headers": {
        "X-Title": "AIOverlay-go"
      },
      "credential_pool": {
        "policy": "round_robin",
        "keys": null,
        "max_keys_per_request": 3,
        "rate_limit_cooldown_s": 60
      },
      "request_defaults": {
        "connect_timeout_ms": 3000,
        "first_token_timeout_ms": 8000,
        "response_timeout_ms": 15000,
        "stream_idle_timeout_ms": 5000,
        "max_output_tokens": 2048
      }
    },
    {
      "id": "nvidia",
      "label": "NVIDIA NIM",
      "kind": "openai_compatible",
      "enabled": true,
      "base_url": "https://integrate.api.nvidia.com/v1",
      "models_url": "https://integrate.api.nvidia.com/v1/models",
      "credential_pool": {
        "policy": "round_robin",
        "keys": null,
        "max_keys_per_request": 3,
        "rate_limit_cooldown_s": 60
      },
      "request_defaults": {
        "connect_timeout_ms": 3000,
        "first_token_timeout_ms": 8000,
        "response_timeout_ms": 15000,
        "stream_idle_timeout_ms": 5000,
        "max_output_tokens": 2048
      }
    },
    {
      "id": "huggingface",
      "label": "Hugging Face Router",
      "kind": "openai_compatible",
      "enabled": true,
      "base_url": "https://router.huggingface.co/v1",
      "models_url": "https://router.huggingface.co/v1/models",
      "credential_pool": {
        "policy": "round_robin",
        "keys": null,
        "max_keys_per_request": 3,
        "rate_limit_cooldown_s": 60
      },
      "request_defaults": {
        "connect_timeout_ms": 3000,
        "first_token_timeout_ms": 8000,
        "response_timeout_ms": 15000,
        "stream_idle_timeout_ms": 5000,
        "max_output_tokens": 2048
      }
    },
    {
      "id": "gemini",
      "label": "Google Gemini",
      "kind": "gemini",
      "enabled": true,
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "credential_pool": {
        "policy": "round_robin",
        "keys": null,
        "max_keys_per_request": 3,
        "rate_limit_cooldown_s": 60
      },
      "request_defaults": {
        "connect_timeout_ms": 3000,
        "first_token_timeout_ms": 8000,
        "response_timeout_ms": 15000,
        "stream_idle_timeout_ms": 5000,
        "max_output_tokens": 2048
      }
    }
  ],
  "pipelines": [
    {
      "id": "round-robin-screenshot",
      "name": "Round Robin Screenshot",
      "description": "Default: rotate the first model each request, then continue by priority until success.",
      "enabled": true,
      "entry_node_id": "screen",
      "output_node_id": "output",
      "budget": {
        "max_wall_time_ms": 30000,
        "max_model_calls": 8,
        "max_parallel_calls": 3,
        "max_providers": 4,
        "max_keys_per_provider": 3,
        "connect_timeout_ms": 3000,
        "first_token_timeout_ms": 8000,
        "response_timeout_ms": 15000,
        "stream_idle_timeout_ms": 5000
      },
      "nodes": [
        {
          "id": "screen",
          "type": "screen",
          "name": "Screen",
          "position": {
            "x": 80,
            "y": 180
          }
        },
        {
          "id": "models",
          "type": "model_pool",
          "name": "Model Pool",
          "position": {
            "x": 360,
            "y": 140
          },
          "model_pool": {
            "policy": "round_robin",
            "models": [
              {
                "id": "mimo",
                "provider_id": "opencode",
                "model_id": "opencode/mimo-v2.5-free",
                "enabled": true,
                "priority": 100,
                "weight": 1.4,
                "quality_score": 90,
                "timeout_ms": 14000,
                "first_token_timeout_ms": 8000,
                "max_attempts": 1
              },
              {
                "id": "muse13",
                "provider_id": "opencode",
                "model_id": "opencode/muse-spark-1.3-contributor-free",
                "enabled": true,
                "priority": 90,
                "weight": 1,
                "quality_score": 84,
                "timeout_ms": 14000,
                "first_token_timeout_ms": 8000,
                "max_attempts": 1
              },
              {
                "id": "muse12",
                "provider_id": "opencode",
                "model_id": "opencode/muse-spark-1.2-contributor-free",
                "enabled": true,
                "priority": 85,
                "weight": 0.8,
                "quality_score": 82,
                "timeout_ms": 14000,
                "first_token_timeout_ms": 8000,
                "max_attempts": 1
              }
            ],
            "prompt": {
              "system": "You are a precise screen-task assistant. Answer the actual task visible in the supplied context. Prioritize correctness. Keep the answer concise unless the task requires explanation. Never invent unreadable details.",
              "user": "Analyze {{screen.image}} and answer the task directly."
            },
            "quality_floor": 80,
            "max_parallel": 3,
            "max_calls": 3,
            "hedge_delay_ms": 2000,
            "round_robin_cursor": 0
          }
        },
        {
          "id": "output",
          "type": "output",
          "name": "Output",
          "position": {
            "x": 760,
            "y": 180
          }
        }
      ],
      "edges": [
        {
          "id": "e-screen-models",
          "from": "screen",
          "to": "models",
          "on": [
            "success"
          ],
          "priority": 100,
          "max_visits": 1
        },
        {
          "id": "e-models-output",
          "from": "models",
          "to": "output",
          "on": [
            "success"
          ],
          "priority": 100,
          "max_visits": 1
        }
      ]
    },
    {
