  "active_pipeline_id": "round-robin-screenshot",
  "overlay": {
    "opacity": 0.82,
    "width": 640,
    "height": 380,
    "font_size": 14,
    "stealth": true,
    "click_through": true,
    "stationary_cursor_ms": 0,
    "hotkeys": {
      "analyze": "Ctrl+Shift+S",
      "clear": "Ctrl+Shift+C",
      "control": "Ctrl+Shift+O",
      "ghost": "Ctrl+Shift+X"
    }
  },
  "control_center": {
    "listen_address": "127.0.0.1:17891",
    "auto_open": false,
    "theme": "engineering-dark"
  },
  "vpn": {
    "enabled": false,
    "engine": "sing-box"
